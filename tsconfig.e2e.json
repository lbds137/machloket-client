{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"newLine": "lf",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "es2022"
	},
	"include": ["e2e/**/*.ts", "playwright.config.ts"]
}
