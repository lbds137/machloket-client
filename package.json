{
	"name": "machloket",
	"version": "0.2.0",
	"description": "Machloket: a Discord-like Spacebar web client (a fork of Fermo), in TypeScript, HTML and CSS.",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"check": "npx tsc -p tsconfig.json --noEmit",
		"check:e2e": "npx tsc -p tsconfig.e2e.json --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"author": "Machloket contributors",
	"license": "AGPL-3.0",
	"dependencies": {
		"vite": "^8.3.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/audioworklet": "^0.0.90",
		"@types/node": "^25.5.0",
		"@types/node-fetch": "^2.6.13",
		"@vitest/browser-playwright": "^5.0.5",
		"playwright": "^1.64.1",
		"prettier": "^3.7.4",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	},
	"prettier": {
		"useTabs": true,
		"printWidth": 100,
		"semi": true,
		"bracketSpacing": false
	}
}
